# Public addresses of the two pre-deployed contracts on GenLayer StudioNet.
# No PRIVATE_KEY here — this project has no server-side wallet. Every write
# (certification requests, job posts, applications) is signed by the caller.
ORACLE_ADDRESS=
BOARD_ADDRESS=
NATIVE_CURRENCY_NAME=GEN
NATIVE_CURRENCY_SYMBOL=GEN
PORT=3000

# Free Project ID from https://cloud.reown.com (formerly WalletConnect Cloud).
# Powers the "Connect Any EVM Wallet" button — lets people connect MetaMask,
# Trust Wallet, Rainbow, Coinbase Wallet, etc. via QR code / deep link. This
# is what makes wallet connect actually work on a normal mobile browser,
# since mobile Chrome/Safari has no injected window.ethereum at all.
WALLETCONNECT_PROJECT_ID=
